{
  // Static site — the deployable files live in public/.
  // Pinning this stops Cloudflare auto-detecting the repo root as the assets
  // directory, which made it try to upload the 416 MB .git folder.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-08-10",
  "assets": {
    "directory": "./public"
  },
  // Custom domain. Only valid while jacobgonzales.tv is an active zone in this
  // Cloudflare account — if the zone is ever removed, the deploy fails and the
  // live site goes with it. Remove these routes before removing the zone.
  "routes": [
    { "pattern": "jacobgonzales.tv", "custom_domain": true },
    { "pattern": "www.jacobgonzales.tv", "custom_domain": true }
  ]
}
