/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/assets/site-config.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/manifest.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/photos-manifest.js
  Cache-Control: public, max-age=0, must-revalidate
